{
  "name": "pubky-app-templates",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start:prod": "node server.js",
    "audit": "npm audit --audit-level=moderate",
    "check": "npm run format:check && npm run lint",
    "format": "prettier \"**/*.{js,ts,json,yml,yaml,md,html}\" --write",
    "format:check": "prettier \"**/*.{js,ts,json,yml,yaml,md,html}\" --check",
    "lint": "npm run lint:code && npm run lint:actions",
    "lint:actions": "github-actionlint .github/workflows/*.yml",
    "lint:code": "eslint .",
    "test:browser": "playwright test",
    "test:deployment": "node --test tests/deployment.test.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "github-actionlint": "^1.7.12",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.73.0"
  },
  "overrides": {
    "github-actionlint": {
      "adm-zip": "0.6.1"
    },
    "minimatch": "^11.0.8"
  },
  "dependencies": {
    "sirv": "3.0.2"
  }
}
